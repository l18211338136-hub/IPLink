[Unit]
Description=IPLink Pure IP Network Tunneling Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/iplink/client.env
ExecStart=/usr/local/bin/iplink-client connect --config /etc/iplink/client.json
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
