{
  "server": {
    "listen_ip": "0.0.0.0",
    "control_port": 29000,
    "relay_port": 29001,
    "nat_port": 29002,
    "http_proxy_port": 28080
  },
  "security": {
    "tls_enabled": false,
    "tls_cert_file": "",
    "tls_key_file": "",
    "token": "${IPLINK_TOKEN}",
    "allowed_targets": ["127.0.0.1:*", "[::1]:*"]
  },
  "relay": {
    "enabled": true,
    "max_sessions": 1000,
    "max_bytes_per_sec": 0
  },
  "metrics": {
    "enabled": true,
    "port": 29100,
    "listen_ip": "127.0.0.1",
    "token": "",
    "allow_query_token": false
  },
  "logging": {
    "level": "info",
    "format": "json"
  }
}
